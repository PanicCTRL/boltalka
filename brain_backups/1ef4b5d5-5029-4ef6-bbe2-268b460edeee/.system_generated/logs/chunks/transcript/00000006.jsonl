{"step_index":399,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-28T04:02:58Z","content":"Created At: 2026-09-28T07:02:58+03:00\nCompleted At: 2026-09-28T07:02:58+03:00\nFile Path: `file:///Y:/STRG/lua_runner.py`\nTotal Lines: 237\nTotal Bytes: 9209\nShowing lines 1 to 70\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"\r\n2: lua_runner.py\r\n3: Модуль исполнения произвольных Lua-стратегий в STRG.\r\n4: Использует lupa (Lua 5.5) для исполнения чистого Lua-кода (CP1251)\r\n5: без зависимостей от QUIK API.\r\n6: Высокопроизводительный numpy-пайплайн (< 1 сек на 175 000 тиков).\r\n7: \"\"\"\r\n8: \r\n9: import os\r\n10: from datetime import datetime\r\n11: import pandas as pd\r\n12: import numpy as np\r\n13: import lupa\r\n14: from lupa import LuaRuntime\r\n15: \r\n16: \r\n17: class LuaStrategyRunner:\r\n18:     \"\"\"Универсальный исполнитель Lua-стратегий на тиковых данных.\"\"\"\r\n19: \r\n20:     def __init__(self, lua_path=r\"Y:\\true_fractal\\true_f_formock.lua\"):\r\n21:         self.lua_path = lua_path\r\n22:         self.lua = None\r\n23:         self.trade_signals = []\r\n24:         self.fractal_levels = []\r\n25:         self.stats = {}\r\n26: \r\n27:     def load_strategy(self, path=None):\r\n28:         \"\"\"Загружает файл стратегии в кодировке CP1251.\"\"\"\r\n29:         if path:\r\n30:             self.lua_path = path\r\n31: \r\n32:         if not os.path.exists(self.lua_path):\r\n33:             raise FileNotFoundError(f\"Файл стратегии не найден: {self.lua_path}\")\r\n34: \r\n35:         self.lua = LuaRuntime(unpack_returned_tuples=True)\r\n36: \r\n37:         with open(self.lua_path, \"r\", encoding=\"cp1251\", errors=\"replace\") as f:\r\n38:             code = f.read()\r\n39: \r\n40:         self.lua.execute(code)\r\n41: \r\n42:     def run(self, df_ticks, bar_period_sec=180):\r\n43:         \"\"\"\r\n44:         Прогоняет тиковый поток через Lua-стратегию.\r\n45:         \r\n46:         :param df_ticks: DataFrame с колонками DATETIME, PRICE, VOL\r\n47:         :param bar_period_sec: Период баров для FeedBar (по умолчанию 180с = 3 мин)\r\n48:         :return: (trade_signals, fractal_levels, stats)\r\n49:         \"\"\"\r\n50:         self.load_strategy()\r\n51: \r\n52:         g = self.lua.globals()\r\n53:         feed_bar = g.FeedBar\r\n54:         feed_tick = g.FeedTick\r\n55: \r\n56:         if df_ticks.empty:\r\n57:             return [], [], {}\r\n58: \r\n59:         # Группировка по интервалам баров\r\n60:         df = df_ticks.copy()\r\n61:         df[\"bar_time\"] = df[\"DATETIME\"].dt.floor(f\"{bar_period_sec}s\")\r\n62:         grouped = df.groupby(\"bar_time\", sort=True)\r\n63: \r\n64:         raw_events = []\r\n65:         level_timeline = []\r\n66:         active_fractals_seen = {}\r\n67:         prev_fractal_set = set()\r\n68:         prev_len = 0\r\n69: \r\n70:         for b_time, group in grouped:\r\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
