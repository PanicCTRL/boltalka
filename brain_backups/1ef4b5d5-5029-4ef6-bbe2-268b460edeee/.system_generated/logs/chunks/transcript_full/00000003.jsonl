lock_utf8.encode('utf-8').decode('utf-8') # text\n\n# Update true_fractal files\nfor p in [r'Y:\\true_fractal\\TODO_TRUE_FRACTAL.md', r'I:\\fractals\\true_fractal\\TODO_TRUE_FRACTAL.md']:\n    with open(p, 'r', encoding='utf-8') as f:\n        t = f.read()\n    if 'Перенос вычислений сигналов и уровней в main()' not in t:\n        with open(p, 'w', encoding='utf-8') as f:\n            f.write(t.rstrip() + '\\n' + block_utf8)\n        print(f'Updated {p}')\n\n# Update my_fractal\nwith open(r'Y:\\my_fractal\\TODO.md', 'r', encoding='cp1251') as f:\n    t = f.read()\nif 'Перенос вычислений сигналов и уровней в main()' not in t:\n    with open(r'Y:\\my_fractal\\TODO.md', 'w', encoding='cp1251') as f:\n        f.write(t.rstrip() + '\\n' + block_utf8)\n    print(r'Updated Y:\\my_fractal\\TODO.md')\n\n# Update STRG\nwith open(r'Y:\\STRG\\TODO_STRG.md', 'r', encoding='utf-8') as f:\n    t = f.read()\nif 'Перенос вычислений сигналов и уровней в main()' not in t:\n    with open(r'Y:\\STRG\\TODO_STRG.md', 'w', encoding='utf-8') as f:\n        f.write(t.rstrip() + '\\n' + block_utf8)\n    print(r'Updated Y:\\STRG\\TODO_STRG.md')\n\"","Cwd":"Y:\\true_fractal","WaitMsBeforeAsync":5000,"toolAction":"Adding architecture task to TODO files","toolSummary":"Append main() calculation architecture task to TODOs"}}]}
