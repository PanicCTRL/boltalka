{"step_index":437,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-29T03:39:43Z","content":"Created At: 2026-09-29T06:39:43+03:00\nCompleted At: 2026-09-29T06:39:44+03:00\n\nThe command exited with code 0.\nOutput:\n--if not lineStart or lineStart == 0 then lineStart = openPrice --; message(\"Нет данных предыдущего дня\") \r\n--end -- Не должно быть так, но проверку, думаю, лучше добавить\r\n-- if lineStart == openPrice and fractal then lineStart = fractal; message(\"Данных предыдущего дня не было\") end\r\n\r\n--if currentFractal < lastFractalUp-(lastFractalUp*delta) then lineStart = lastFractalUp; lineEnd = currentFractal end\r\n--if currentFractal > lastFractalDown*(delta+1) then lineStart = lastFractalDown; lineEnd = currentFractal end \r\n\r\n-- Параметры и переменные трендовой линии регрессии\r\ndeviation       = 0.008 -- 0.8% минимальный порог размаха тренда\r\n\r\nlineStart       = 0     -- Цена начала базового отрезка\r\nlineEnd         = 0     -- Цена конца базового отрезка\r\nstartBar        = 0     -- Номер бара начала отрезка (для регрессии X)\r\nendBar          = 0     -- Номер бара конца отрезка (для регрессии X)\r\ntrendDir        = 0     -- 0: боковик (нет тренда), 1: тренд вверх, -1: тренд вниз\r\n\r\nlastFractalUp   = 0     -- Последний зафиксированный максимум\r\nlastFractalDown = 0     -- Последний зафиксированный минимум\r\nlastBarUp       = 0     -- Бар последнего максимума\r\nlastBarDown     = 0     -- Бар последнего минимума\r\n\r\n-- Функция обновления опорной линии при появлении нового подтвержденного фрактала\r\n-- isUp: true если фрактал вверх, false если фрактал вниз\r\n-- price: цена экстремума фрактала\r\n-- barIdx: порядковый номер свечи фрактала\r\nfunction UpdateTrendLine(isUp, price, barIdx)\r\n    -- 1. Запоминаем свежий фрактал\r\n    if isUp then\r\n        lastFractalUp = price\r\n        lastBarUp = barIdx\r\n    else\r\n        lastFractalDown = price\r\n        lastBarDown = barIdx\r\n    end\r\n\r\n    -- 2. ФАЗА БОВИКА (trendDir == 0): ждем первое истинное движение > 0.8%\r\n    if trendDir == 0 then\r\n        if lastFractalUp > 0 and lastFractalDown > 0 then\r\n            -- Проверка импульса вверх от низины\r\n            if isUp and price >= lastFractalDown * (1 + deviation) then\r\n                trendDir  = 1\r\n                lineStart = lastFractalDown\r\n                startBar  = lastBarDown\r\n                lineEnd   = price\r\n                endBar    = barIdx\r\n            -- Проверка импульса вниз от вершины\r\n            elseif not isUp and price <= lastFractalUp * (1 - deviation) then\r\n                trendDir  = -1\r\n                lineStart = lastFractalUp\r\n                startBar  = lastBarUp\r\n                lineEnd   = price\r\n                endBar    = barIdx\r\n            end\r\n        end\r\n        return\r\n    end\r\n\r\n    -- 3. ФАЗА ТРЕНДА ВВЕРХ (trendDir == 1)\r\n    if trendDir == 1 then\r\n        if isUp then\r\n\n"}
