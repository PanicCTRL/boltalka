{"step_index":401,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-28T04:03:01Z","content":"Created At: 2026-09-28T07:03:01+03:00\nCompleted At: 2026-09-28T07:03:02+03:00\n\nThe command exited with code 0.\nOutput:\n-- true_f_formock.lua\r\n-- Изолированное ядро стратегии True Fractal для тестирования, моков и портирования на Python\r\n-- Без зависимостей от QUIK API\r\n\r\n-- ============================================================================\r\n-- 1. НАСТРОЙКИ СТРАТЕГИИ\r\n-- ============================================================================\r\noperation       = \"B\"       -- Направление торговли: \"B\" (Buy / Long) или \"S\" (Sell / Short)\r\ncount_trades    = 4         -- Количество разрешенных попыток входа на одном фрактале\r\nslOffset        = 75        -- Размер стоп-лосса в пунктах от цены входа\r\ntpOffset        = 750       -- Размер тейк-профита в пунктах от цены входа\r\n\r\n-- ============================================================================\r\n-- 2. СОСТОЯНИЕ И ПЕРЕМЕННЫЕ\r\n-- ============================================================================\r\nmaxPrices       = {}        -- Таблица максимумов за последние 5 баров\r\nminPrices       = {}        -- Таблица минимумов за последние 5 баров\r\nfractals        = {}        -- Хранилище последних найденных фракталов (до 6 штук)\r\n\r\nstartPrice      = 0         -- Текущий рабочий фрактальный уровень\r\nlastFractal     = 0         -- Последний обработанный фрактал (для отслеживания смены уровня)\r\ncount_t         = count_trades  -- Счётчик оставшихся реальных попыток\r\ncount_v         = count_trades  -- Счётчик оставшихся виртуальных попыток\r\n\r\ncurrentPrice    = 0         -- Текущая цена (последний тик)\r\nprevPrice       = 0         -- Предыдущая цена тика\r\n\r\nopn             = false     -- Флаг: находимся ли в реальной позиции\r\nstop_price      = 0         -- Уровень стоп-лосса текущей реальной сделки\r\ntake_price      = 0         -- Уровень тейк-профита текущей реальной сделки\r\n\r\nvirt            = false     -- Флаг: находимся ли в виртуальной позиции\r\nvirt_stop       = 0         -- Уровень стопа виртуальной позиции\r\nvirt_take       = 0         -- Уровень тейка виртуальной позиции\r\n\r\n-- Таблица для сбора истории событий мока (логи сделок, сигналов, фракталов)\r\nhistory_log     = {}\r\n\r\nfunction LogMockEvent(eventType, message)\r\n    table.insert(history_log, {\r\n        type  = eventType,\r\n        msg   = message,\r\n        price = currentPrice,\r\n        t_left = count_t,\r\n        v_left = count_v,\r\n        opn   = opn,\r\n        virt  = virt,\r\n        start = startPrice\r\n    })\r\nend\r\n\n"}
